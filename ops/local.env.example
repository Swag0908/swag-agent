# 复制为 ops/local.env。当前电脑会先自动复用已有 deploy/config.env。
SERVER_HOST=your-server
SSH_USER=root
SSH_PORT=22
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PASSWORD=
PY_REMOTE_ROOT=/opt/swag_agent/python-deploy
PY_NGINX_CONFIG=/etc/nginx/conf.d/swag-agent.conf
PY_SITE_HOST=your-domain.example
BACKEND_SERVICE=swag-agent
