# swag-agent-backend 环境变量模板
# 服务器上操作：
#   sudo cp swag-agent-backend.env.example /etc/swag-agent-backend.env
#   sudo chmod 600 /etc/swag-agent-backend.env
#   sudo vim /etc/swag-agent-backend.env   # 填入真实值
# 修改 env 后执行：sudo systemctl restart swag-agent-backend

# ---- 必填：应用启动必需的三类密钥 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
MYSQL_PASSWORD=你的MySQL密码
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ---- 可选：JVM 参数（留空/删除即可不设置）----
JAVA_OPTS=-Xmx512m

# ---- 可选：数据库连接 ----
# 只有当服务器上打包的 jar 里【没有】application-dev.properties、
# 或后端要连的库和本地不同时才需要下面两行。
# 说明：application-dev.properties 被 .gitignore 忽略，不会进 git；
#      若 jar 是在服务器上 git clone 后打包的，里面就没有数据源地址，必须配置：
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/swag_ai_agent?useUnicode=true&characterEncoding=utf-8&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=root
